{
  "name": "onestep-money",
  "version": "2.1.26",
  "description": "A local-first, ADHD-friendly UK finance and debt companion built around one clear move at a time.",
  "private": true,
  "type": "module",
  "main": "main-entry.js",
  "author": "OneStep Money contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cntintheslk-OneStepMoney/onestep-money.git"
  },
  "homepage": "https://github.com/cntintheslk-OneStepMoney/onestep-money#readme",
  "bugs": {
    "url": "https://github.com/cntintheslk-OneStepMoney/onestep-money/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.mjs && node scripts/privacy-check.mjs",
    "lint": "eslint .",
    "benchmark:quality": "node scripts/benchmark-quality.mjs",
    "start": "electron .",
    "desktop": "electron .",
    "demo": "node static-preview-server.js",
    "preview": "node static-preview-server.js",
    "capture": "electron . --capture-ui",
    "dist:win": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always",
    "build:pages": "node scripts/build-pages-site.mjs",
    "smoke:pages": "electron scripts/pages-runtime-smoke.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5"
  },
  "build": {
    "appId": "uk.co.onestepmoney.app",
    "productName": "OneStep Money",
    "asar": true,
    "files": [
      "automation-dashboard.css",
      "automation-dashboard.js",
      "automation-dashboard-ui.js",
      "automation-dashboard-render.js",
      "automation-engine.js",
      "automation-history.js",
      "automation-history-runner.js",
      "automation-history-ui.js",
      "automation-review-integration.js",
      "automation-rule-model.js",
      "automation-rules-core.js",
      "automation-rules.js",
      "automation-rules-ui.js",
      "automation-state.js",
      "financial-reminders.js",
      "financial-reminders-ui.js",
      "financial-presentation-forecast.js",
      "financial-presentation-debt.js",
      "cash-flow-forecast.js",
      "data-store.js",
      "date-utils.js",
      "debt-recommendation-engine.js",
      "diagnostic-logger.js",
      "assets/**",
      "build/icon.ico",
      "document-import.js",
      "document-deduplication.js",
      "finance-core.js",
      "financial-reporting.js",
      "index.html",
      "local-llm-service.js",
      "main-entry.js",
      "main-process.js",
      "next-move-priority.js",
      "payment-bulk-review.js",
      "payment-bulk-review-ui.js",
      "payday-allocation.js",
      "payday-allocation-ui.js",
      "payday-awareness.js",
      "payday-awareness-ui.js",
      "pdf-service.js",
      "payslip-record.js",
      "preload-bridge.cjs",
      "presentation-settings.js",
      "recurring-finance.js",
      "recurring-finance-ui.js",
      "renderer-app.js",
      "review-lifecycle-base.js",
      "review-lifecycle.js",
      "credit-report-intelligence.js",
      "statement-intelligence.js",
      "statement-reconciliation.js",
      "transaction-categorisation.js",
      "transaction-ledger.js",
      "unified-financial-profile.js",
      "seed-data.json",
      "styles.css",
      "update-service.js",
      "update-ui.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "onestep-money-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [{"provider":"github","releaseType":"release"}]
  }
}
